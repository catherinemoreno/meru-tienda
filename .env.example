# Copia este archivo a .env.local y completa los valores reales.
# .env.local NUNCA se sube a git (ver .gitignore).

# --- Supabase ---------------------------------------------------------------
# Si estas tres variables NO están definidas, la app funciona igual con
# datos de demostración (mock) — no rompe nada dejarlas vacías en local.

# Project URL de Supabase (Project Settings > API). Pública, se usa en el
# navegador.
NEXT_PUBLIC_SUPABASE_URL=

# anon public key de Supabase (Project Settings > API). Pública, se usa en
# el navegador junto con Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key de Supabase (Project Settings > API).
# SECRETA — SOLO SERVIDOR. Salta RLS por completo. NUNCA le pongas el
# prefijo NEXT_PUBLIC_, nunca la commitees con un valor real, y nunca la
# referencies desde código que corra en el navegador (componentes "use
# client"). Solo se usa desde src/lib/supabase/admin.ts, importado desde
# API routes en src/app/api/**.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (envío de email al recibir un pedido, opcional) ----------------
# Si no está definida, sendNewOrderEmail solo loguea en consola.
RESEND_API_KEY=
RESEND_FROM_EMAIL=pedidos@meru.co

# --- Panel administrativo ----------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=meru2024
ADMIN_SESSION_SECRET=cambia-este-valor-en-produccion

# --- SEO ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://meru.co
